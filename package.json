{
  "name": "verify-anything",
  "version": "0.2.0",
  "description": "Is this true? Verify a claim, URL, file, or AI answer: up to 20 claims (configurable) judged against web sources, with confidence, the evidence span, and the reason. CLI + MCP server.",
  "type": "module",
  "bin": {
    "verify": "dist/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "NO_COLOR=1 node --import tsx --test tests/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "fact-check",
    "verification",
    "ai",
    "agents",
    "mcp",
    "hallucination",
    "citations",
    "truth",
    "llm"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LastSearch-HQ/verify.git"
  },
  "homepage": "https://lastsearch.ai",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "tsx": "^4.19.0",
    "@types/node": "^26.6.5"
  }
}
